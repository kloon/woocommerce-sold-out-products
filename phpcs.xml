<?xml version="1.0"?>
<ruleset name="WooCommerce Sold Out Products Coding Standards">
	<description>A custom set of code standard rules for WooCommerce Sold Out Products plugin.</description>

	<!-- Configs -->
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Files to check -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>svn-repo/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*.asset.php</exclude-pattern>

	<!-- Args -->
	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- WooCommerce Coding Standards -->
	<rule ref="WooCommerce-Core">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Use WordPress array short syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- PHP Compatibility -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress specific rules -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wc-sold-out-products"/>
			</property>
		</properties>
	</rule>

	<!-- File naming -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
		<exclude-pattern>woocommerce-sold-out-products.php</exclude-pattern>
	</rule>

	<!-- Allow trigger_error for deprecations -->
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_trigger_error">
		<type>warning</type>
	</rule>

	<!-- Disallow long array syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- Allow some naming flexibility for WC compatibility -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wc_sold_out"/>
				<element value="WC_Sold_Out"/>
				<element value="Kloon"/>
			</property>
		</properties>
	</rule>

	<!-- Allow hook name flexibility for WC compatibility -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="-"/>
		</properties>
	</rule>
</ruleset>
