{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wc-sold-out-products/sold-out-products",
	"version": "2.0.0",
	"title": "Sold Out Products",
	"category": "woocommerce",
	"description": "Display a grid of sold out products from your WooCommerce store.",
	"keywords": [
		"sold out",
		"out of stock",
		"products",
		"woocommerce"
	],
	"textdomain": "wc-sold-out-products",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 4
		},
		"rows": {
			"type": "number",
			"default": 3
		},
		"orderby": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"inserter": true,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:../../../build/index.js",
	"editorStyle": "file:../../../build/index.css",
	"style": "file:../../../build/style-index.css",
	"render": "file:./render.php"
}
